*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv/
*.egg-info/
.eggs/
dist/
build/
*.egg
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# =========================
# Node / Frontend
# =========================
node_modules/
.svelte-kit/
build/
.env
.env.*
!.env.example
*.local
.vercel
.output
.nitro
.cache

# =========================
# IDE / Editor
# =========================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =========================
# Logs & Debug
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# Testing
# =========================
coverage/
.nyc_output/

# =========================
# Misc
# =========================
*.bak
*.tmp
*.temp
